{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "concept_id", "task_id", "task_type", "outcome", "assistance", "error_tags", "diagnostic_confidence", "source_refs"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "observation_id": {"type": "string", "minLength": 1},
    "concept_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "enum": ["definition_recall", "formula_reading", "recognition", "explanation", "error_detection", "worked_example", "faded_example", "guided_problem", "independent_problem", "transfer", "exam_problem", "delayed_recall"]},
    "outcome": {"type": "string", "enum": ["correct", "partial", "incorrect", "skipped", "solution_seen"]},
    "assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "levels_revealed", "scaffold_types", "partial_transformation_shown", "full_solution_viewed"],
      "properties": {
        "requested": {"type": "boolean"},
        "levels_revealed": {"type": "array", "items": {"type": "string", "enum": ["H0", "H1", "H2", "H3", "H4", "H5"]}},
        "scaffold_types": {"type": "array", "items": {"type": "string"}},
        "partial_transformation_shown": {"type": "boolean"},
        "full_solution_viewed": {"type": "boolean"}
      }
    },
    "error_tags": {"type": "array", "items": {"type": "string", "enum": ["conceptual_error", "formula_recall_error", "algebra_error", "method_selection_error", "notation_error", "careless_error", "speed_problem", "prerequisite_gap", "domain_condition_error", "proof_structure_error"]}},
    "diagnostic_confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "learner_self_confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "learner_explanation": {"type": "string"},
    "source_refs": {"type": "array", "items": {}},
    "assessment_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "explicit_exposure_reason": {"type": "string", "minLength": 1},
    "solution_exposed": {"type": "boolean"},
    "evidence_facets": {"type": "array", "items": {"type": "string"}}
  }
}

