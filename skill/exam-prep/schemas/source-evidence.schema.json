{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized SourceEvidenceEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_id", "status", "evidence", "diagnostics"],
  "properties": {
    "provider_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ok", "unavailable", "failed"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref"],
        "properties": {
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "authority", "locator", "provider_id"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "minLength": 1},
              "locator": {"type": "string"},
              "provider_id": {"type": "string", "minLength": 1},
              "title": {"type": ["string", "null"]},
              "excerpt": {"type": ["string", "null"]},
              "content_hash": {"type": ["string", "null"]},
              "artifact_id": {"type": ["string", "null"]},
              "retrieved_at": {"type": ["string", "null"]}
            }
          },
          "excerpt": {"type": ["string", "null"]},
          "evidence_id": {"type": ["string", "null"]},
          "relevance": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
