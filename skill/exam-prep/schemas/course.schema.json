{
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "course_id", "title", "exam", "time_budget", "source_policy", "scheduler"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "course_id": {"type": "string"},
    "title": {"type": "string"},
    "language": {"type": ["string", "null"], "minLength": 2},
    "language_source": {"type": "string", "enum": ["configured", "detected", "unknown"]},
    "language_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "language_detection_attempted": {"type": "boolean"},
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {"type": ["string", "null"]},
        "timezone": {"type": ["string", "null"]},
        "format": {"type": ["string", "null"]},
        "delivery": {"type": "string", "enum": ["written", "oral", "mixed"]},
        "question_model": {"type": "string", "enum": ["ticket_list", "problem_set", "mixed", "open"]},
        "question_count": {"type": ["integer", "null"], "minimum": 0},
        "time_limit_minutes": {"type": ["integer", "null"], "minimum": 0},
        "per_question_minutes": {"type": ["number", "null"], "minimum": 0},
        "points": {"type": ["number", "null"], "minimum": 0},
        "expected_total_points": {"type": ["number", "null"], "minimum": 0},
        "follow_up_questions": {"type": "boolean"},
        "verbatim_definitions": {"type": "boolean"},
        "grading_criteria": {"type": ["array", "null"], "items": {"type": "string"}},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "time_budget": {"type": "object"},
    "source_policy": {"type": "object"},
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["normal", "accelerated", "emergency", "exam_cram"]},
        "max_review_interval_hours": {"type": "integer", "minimum": 1},
        "review_warmup_limit": {"type": "integer", "minimum": 0},
        "recurring_mistake_sessions": {"type": "integer", "minimum": 0},
        "recurring_mistake_policy": {"type": "object"}
      }
    }
  }
}

