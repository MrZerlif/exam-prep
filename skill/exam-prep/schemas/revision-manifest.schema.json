    "schema_version": {"type": "integer", "enum": [1, 2]},
    "revision": {"type": "integer", "minimum": 0},
    "last_complete_observation_line": {"type": "integer", "minimum": 0},
    "log_byte_offset": {"type": "integer", "minimum": 0},
    "last_complete_observation_id": {"type": ["string", "null"]},
    "course_hash": {"type": ["string", "null"]},
    "syllabus_hash": {"type": ["string", "null"]},
    "derived_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "canonical_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "course_hash": {"type": ["string", "null"]},
        "syllabus_hash": {"type": ["string", "null"]},
        "observations_hash": {"type": "string", "minLength": 1},
        "assessments_hash": {"type": "string", "minLength": 1},
        "source_evidence_hash": {"type": "string", "minLength": 1},
        "sessions_hash": {"type": "string", "minLength": 1},
        "source_manifest_hash": {"type": ["string", "null"]},
        "observation_count": {"type": "integer", "minimum": 0},
        "assessment_count": {"type": "integer", "minimum": 0},
        "source_evidence_count": {"type": "integer", "minimum": 0}
      }
    },
    "schema_versions": {"type": "object", "additionalProperties": true},
    "derived_snapshot_hash": {"type": "string", "minLength": 1}
  }
}

