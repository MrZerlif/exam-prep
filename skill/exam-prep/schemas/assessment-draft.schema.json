{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssessmentDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessments"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "target_id", "capability_id", "prompt", "rubric", "expected_evidence", "source_refs", "difficulty", "question_version", "rubric_version", "origin", "purpose"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "target_id": {"type": ["string", "null"]},
          "capability_id": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "rubric": {"type": "object"},
          "expected_evidence": {"type": "array"},
          "source_refs": {"type": "array"},
          "difficulty": {"type": "number", "minimum": 0, "maximum": 1},
          "question_version": {"type": "integer", "const": 1},
          "rubric_version": {"type": "integer", "const": 1},
          "origin": {"type": "string", "enum": ["extracted", "authored", "model_generated"]},
          "purpose": {"type": "string", "enum": ["practice", "retest", "held_out", "mock"]},
          "options": {"type": "array", "items": {"type": "string"}},
          "points": {"type": ["integer", "null"]},
          "question_hash": {"type": ["string", "null"]},
          "issues": {"type": "array"}
        }
      }
    },
    "issues": {"type": "array"}
  }
}
