{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "target_id",
    "task_id",
    "capability_id",
    "task_type",
    "outcome",
    "assistance",
    "error_tags",
    "diagnostic_confidence",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "correct",
        "partial",
        "incorrect",
        "skipped",
        "solution_seen"
      ]
    },
    "assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels_revealed"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "levels_revealed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "H0",
              "H1",
              "H2",
              "H3",
              "H4",
              "H5"
            ]
          }
        },
        "scaffold_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partial_transformation_shown": {
          "type": "boolean"
        },
        "full_solution_viewed": {
          "type": "boolean"
        }
      }
    },
    "error_tags": {
      "type": "array"
    },
    "diagnostic_confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "learner_self_confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "learner_explanation": {
      "type": "string"
    },
    "source_refs": {
      "type": "array"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_spec_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "spec_hash": {
          "type": "string",
          "minLength": 1
        },
        "assessment_spec_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "solution_exposed": {
      "type": "boolean"
    },
    "explicit_exposure_reason": {
      "type": "string",
      "minLength": 1
    },
    "exposure_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "evaluation_context": {
      "type": "object",
      "additionalProperties": true
    },
    "assessment_result": {
      "type": "object",
      "additionalProperties": true
    },
    "evaluation_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "activity_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
